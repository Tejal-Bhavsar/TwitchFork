PORT=3000
# Twitch Developer Console credentials for live public profiles/streams.
# Keep the secret server-side in .env; never put it in public/app.js.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: connect a bot to a channel and accept !fork [parent_channel]
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_CHANNEL=
# Optional EventSub webhook signature verification
TWITCH_EVENTSUB_SECRET=
# Optional AI attribution summaries
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
